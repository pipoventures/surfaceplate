/* The approved mockup's own chrome (artifact 8b82b21c, "Adopt, Two Ways").
   Colours are taken from it rather than chosen again: ground #0e1316, border #262c30,
   ink #dce0dd, muted #7a827e, amber accent #d79a3c, success #6fae8a. */

Screen {
    background: #0e1316;
    color: #dce0dd;
}

#frame {
    border: round #262c30;
    padding: 1 2;
    height: 1fr;
}

.section-header {
    color: #7a827e;
    margin-bottom: 1;
}

.section-subline {
    color: #7a827e;
}

.intro {
    color: #dce0dd;
    height: auto;
    margin: 0 0 1 0;
}

/* One line each, not double-spaced: the recap is a short list, and a blank line between every
   entry pushed the options it exists to inform off the screen. */
.recap {
    color: #7a827e;
    height: auto;
    margin: 0;
}

.note {
    color: #6fae8a;
}

.rule {
    color: #262c30;
}

/* --- the hint line: always the last row, kbd chips and the current field's help --- */
#hint {
    dock: bottom;
    height: auto;
    /* Four content rows: the gate list's counter and two-row legend plus an error, at 80
       columns where the legend wraps. `height: auto` keeps every other screen's hint short. */
    max-height: 6;
    color: #7a827e;
    border-top: solid #262c30;
    padding-top: 1;
}

.error {
    color: #d79a3c;
}

/* --- generic form rows: a fixed label column, values in ink (mockup frame 01) ---
   The row is a HorizontalGroup, so the label genuinely sits BESIDE its value. Heights are held to
   one line wherever possible: F37 #6 was caused by exactly this kind of vertical slack, three or
   four rows per field, which pushed everything but one gate off the screen. */
/* "Sometimes it is difficult to distinguish one line from the next." A hairline under each row
   and a lift on the focused one; the row you are in should never be in doubt. */
.field-row {
    height: auto;
    margin: 0;
    border-bottom: solid #1c2226;
    padding: 0 0 0 1;
}

.field-row:focus-within {
    background: #12181b;
    border-left: thick #d79a3c;
    padding: 0;
}

/* Proportional, not fixed. At `width: 32` on an 80-column terminal the value column got the
   remaining ~44 characters, and the two most consequential choices in the wizard could not be read:
   `Set defaults - propose answers f…` and `Customise adoption - ask me each…`. A share of the
   terminal gives the narrow case room and still stops the label sprawling on a wide one. */
/* `F56`: labels WRAP, they do not clip. `height: 1` with `text-overflow: ellipsis` cut 28 labels
   at 80 columns - every control's "Why does X apply here?", the gate's "Precondition artefact",
   "Adoption decision record ID" - and **the ellipsis never rendered**, exactly as it did not for
   `.gate-desc` before `F42`. An adopter saw a fragment of a question with nothing to say a question
   had been shortened.
   Most predate `ACT-035`: at the previous fixed `width: 32` anything longer was already cut. Making
   the column proportional (so the route screen's options became readable) widened it to shorter
   labels too. Wrapping costs vertical space in a frame that already scrolls, and loses nothing. */
.field-label {
    width: 28%;
    min-width: 16;
    max-width: 34;
    color: #7a827e;
    height: auto;
}

/* A slot you can SEE, even empty and even without colour. "Difficult sometimes to follow and know
   where you must add text" was the report; a background tint alone does not carry that, so every
   input keeps an underline, which is visible in monochrome and in a rendered-text test. */
Input, TextArea {
    background: #12181b;
    border: none;
    border-bottom: solid #39424a;
    color: #dce0dd;
    padding: 0 1;
    width: 1fr;
    height: 2;
}

/* The focused field keeps its underline - in the accent, so focus is obvious - rather than losing
   it to `border: none`, which removed the slot from the one field you are actually typing in. */
Input:focus, TextArea:focus {
    background: #171c1f;
    border: none;
    border-bottom: solid #d79a3c;
}

TextArea {
    height: 2;
}

Checkbox {
    background: #0e1316;
    border: none;
}

Checkbox:focus {
    background: #171c1f;
}

/* `F67`: the help line beside the focused field had no rule at all, so it rendered in the
   screen's full ink - louder than the label it explains - flush against the frame, and touching
   the next field. Muted, indented under its field, and one row clear of whatever follows. */
.field-help {
    color: #7a827e;
    margin: 0 0 1 2;
}

/* --- level screen (mockup frame 02): highlight is not selection --- */
OptionList {
    background: #0e1316;
    border: none;
    padding: 0;
}

OptionList > .option-list--option-highlighted {
    background: #1c1f1c;
    color: #dce0dd;
    text-style: bold;
}

.level-meta {
    color: #d79a3c;
    margin-left: 4;
}

/* --- gate catalogue (mockup frame 03): several gates at once --- */
.gate {
    height: auto;
    border-bottom: solid #262c30;
    padding: 0;
    margin: 0;
}

.gate-body { height: auto; }

/* One line, and the whole reason nineteen gates can be worked through. */
.gate-summary {
    height: 1;
    color: #6fae8a;
}

.gate-focused {
    background: #12181b;
}

.gate-name {
    color: #dce0dd;
    text-style: bold;
}

/* `F42`: `height: 1` discarded most of every explanation, and the declared ellipsis never
   rendered. The summary is now budgeted in `_first_sentence` and carries its own `…`, so this
   only has to let the budgeted text wrap - at 80 columns that is two rows, not five. */
.gate-desc {
    color: #7a827e;
    height: auto;
}

/* `F59`: `height: 1` left Textual's `RadioSet` - which draws a two-row `tall` border plus padding
   by default - with no row for its buttons, so every undecided gate's status rendered as an empty
   bordered box at every terminal size. The border and padding go too: one row per option, nothing
   else. (The `.chip`/`.chip-selected` rules that stood here styled nothing since the radio rewrite.) */
.chip-row {
    height: auto;
    border: none;
    padding: 0;
    margin: 0;
}

.followups {
    margin: 0;
    margin-left: 2;
    height: auto;
}

.gate-locked {
    color: #6fae8a;
}

/* --- review --- */
/* The review's frame: the same border as every screen, and no inner padding, because every row
   here is a row of profile the list can show at 80x24. The list takes what the notes leave. */
#review-frame {
    border: round #262c30;
    padding: 0 1;
    height: 1fr;
}

#review-body {
    height: 1fr;
    border: none;
    padding: 0;
    background: #0e1316;
}

#review-body > .option-list--option-highlighted {
    background: #1c1f1c;
    color: #dce0dd;
    text-style: bold;
}

#review-error {
    color: #d79a3c;
    height: auto;
}


/* The dropdown: obviously a control, without eating three rows per field. */
Select {
    width: 1fr;
    height: 3;   /* its own prompt row plus the underline; 2 clipped the prompt entirely */
    border: none;
    border-bottom: solid #39424a;
    background: #12181b;
}

Select:focus {
    border-bottom: solid #d79a3c;
}

SelectionList {
    background: #0e1316;
    border: none;
    height: auto;
    max-height: 6;
}

/* On/off must differ in SHAPE, not only in colour - see VisibleCheckbox. */
Checkbox > .toggle--button, RadioButton > .toggle--button {
    color: #6fae8a;
    background: #1c2226;
}
