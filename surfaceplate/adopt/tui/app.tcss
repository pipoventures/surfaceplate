/* The approved mockup's own chrome (artifact 8b82b21c, "Adopt, Two Ways").
   Colours are taken from it rather than chosen again: ground #0e1316, border #262c30,
   ink #dce0dd, muted #7a827e, amber accent #d79a3c, success #6fae8a. */

Screen {
    background: #0e1316;
    color: #dce0dd;
}

#frame {
    border: round #262c30;
    padding: 1 2;
    height: 1fr;
}

.section-header {
    color: #7a827e;
    margin-bottom: 1;
}

.section-subline {
    color: #7a827e;
}

.intro {
    color: #dce0dd;
    height: auto;
    margin: 0 0 1 0;
}

/* One line each, not double-spaced: the recap is a short list, and a blank line between every
   entry pushed the options it exists to inform off the screen. */
.recap {
    color: #7a827e;
    height: auto;
    margin: 0;
}

.note {
    color: #6fae8a;
}

.rule {
    color: #262c30;
}

/* --- the hint line: always the last row, kbd chips and the current field's help --- */
#hint {
    dock: bottom;
    height: auto;
    max-height: 4;
    color: #7a827e;
    border-top: solid #262c30;
    padding-top: 1;
}

.error {
    color: #d79a3c;
}

/* --- generic form rows: a fixed label column, values in ink (mockup frame 01) ---
   The row is a HorizontalGroup, so the label genuinely sits BESIDE its value. Heights are held to
   one line wherever possible: F37 #6 was caused by exactly this kind of vertical slack, three or
   four rows per field, which pushed everything but one gate off the screen. */
.field-row {
    height: auto;
    margin: 0;
}

.field-label {
    width: 32;
    color: #7a827e;
    height: 1;
    text-overflow: ellipsis;
}

/* A slot you can SEE, even empty and even without colour. "Difficult sometimes to follow and know
   where you must add text" was the report; a background tint alone does not carry that, so every
   input keeps an underline, which is visible in monochrome and in a rendered-text test. */
Input, TextArea {
    background: #12181b;
    border: none;
    border-bottom: solid #39424a;
    color: #dce0dd;
    padding: 0 1;
    width: 1fr;
    height: 2;
}

/* The focused field keeps its underline - in the accent, so focus is obvious - rather than losing
   it to `border: none`, which removed the slot from the one field you are actually typing in. */
Input:focus, TextArea:focus {
    background: #171c1f;
    border: none;
    border-bottom: solid #d79a3c;
}

TextArea {
    height: 2;
}

Checkbox {
    background: #0e1316;
    border: none;
}

Checkbox:focus {
    background: #171c1f;
}

/* --- level screen (mockup frame 02): highlight is not selection --- */
OptionList {
    background: #0e1316;
    border: none;
    padding: 0;
}

OptionList > .option-list--option-highlighted {
    background: #1c1f1c;
    color: #dce0dd;
    text-style: bold;
}

.level-meta {
    color: #d79a3c;
    margin-left: 4;
}

/* --- gate catalogue (mockup frame 03): several gates at once --- */
.gate {
    height: auto;
    border-bottom: solid #262c30;
    padding: 0;
    margin: 0;
}

.gate-body { height: auto; }

/* One line, and the whole reason nineteen gates can be worked through. */
.gate-summary {
    height: 1;
    color: #6fae8a;
}

.gate-focused {
    background: #12181b;
}

.gate-name {
    color: #dce0dd;
    text-style: bold;
}

.gate-desc {
    color: #7a827e;
    height: 1;
    text-overflow: ellipsis;
}

.chip-row {
    height: 1;
    margin: 0;
}

.chip {
    border: none;
    min-width: 18;
    height: 1;
    background: #0e1316;
    color: #7a827e;
}

.chip-selected {
    background: #d79a3c;
    color: #0e1316;
    text-style: bold;
}

.followups {
    margin: 0;
    margin-left: 2;
    height: auto;
}

.gate-locked {
    color: #6fae8a;
}

/* --- review --- */
#review-body {
    height: 1fr;
    border: solid #262c30;
    padding: 1;
}

#review-error {
    color: #d79a3c;
    height: auto;
}


/* The dropdown: obviously a control, without eating three rows per field. */
Select {
    width: 1fr;
    height: 3;   /* its own prompt row plus the underline; 2 clipped the prompt entirely */
    border: none;
    border-bottom: solid #39424a;
    background: #12181b;
}

Select:focus {
    border-bottom: solid #d79a3c;
}

SelectionList {
    background: #0e1316;
    border: none;
    height: auto;
    max-height: 6;
}

/* On/off must differ in SHAPE, not only in colour - see VisibleCheckbox. */
Checkbox > .toggle--button, RadioButton > .toggle--button {
    color: #6fae8a;
    background: #1c2226;
}
