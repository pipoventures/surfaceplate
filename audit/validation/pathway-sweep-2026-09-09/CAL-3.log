# Application Profile — a1
#
# Written by `surfaceplate adopt` on 2026-09-09. The origin of every value below is recorded in
# application-profile.provenance.yaml beside this file: values marked typed there were entered at
# the keyboard; the rest were proposed by the tool from the sources recorded there and approved
# as one document at the review. See core/CONFORMANCE_LEVELS.md and core/PREREQUISITE_GATES.md
# for what each section means.

schema_version: "1.0"
application_id: a1
display_name: a1  # not checked
owner: needs-human

stack: {language: needs-human}

risk_profile: needs-human
materiality_definition: Not stated at adoption.
data_classification: public         # public | internal | confidential | restricted

# Why the level below was chosen (DR-50): recorded, not checked.
risk:
  relied_on_outside_team: false
  material_quantitative_output: false

# See core/CONFORMANCE_LEVELS.md. A level is a floor, not a ceiling.
conformance_level: essential

adoption:
  framework_version: 0.17.0
  framework_digest: ceffdcf76ae5440ceae16c154893c3771455db0ad7aaa36d245bbe67db4c8d7f
  adoption_date: '2026-09-09'
  review_by: '2027-03-08'
  framework_maintainer: needs-human
  repository_classification: public  # not checked
  decision_record_id: DR-0001
  adoption_status: in_progress
  independent_validator: null  # not checked
  deferrals: []

# These three cannot be excluded, deferred, or omitted at any conformance level.
baseline_controls:
  agent_work_packets:  # DECLARED ONLY - nothing checks this; it is a stated obligation
    decision: required
    rationale: All agent work is bounded, scoped, and reviewable.
  actual_diff_review:  # DECLARED ONLY - nothing checks this; it is a stated obligation
    decision: required
    rationale: Material changes require actual diff content, not a file list.
  secret_hygiene:  # checked against this repository by the conformance checker
    decision: required
    rationale: No secrets or customer data may enter the repository or fixtures.
    scanner:
      name: gitleaks
      wired_in: [needs-human]

control_decisions:
  # ---- Topic 9: Dependencies and supply chain ----
  dependency_lock:  # checked against this repository by the conformance checker
    decision: required
    rationale: Supply-chain exposure exists regardless of output materiality.
    implementation_reference: needs-human

# Prerequisite gates: "artefact X must exist before activity Y may begin". See
# core/PREREQUISITE_GATES.md for the 19-gate catalogue and what each one guards.
builds_user_interface: false
prerequisites:
  - id: work_registration
    status: required
    effective_from: '2026-09-09'
    precondition:
      artefacts: [activity/register.md]
      description: No work begins until it is registered as an identified activity.
    gated_activity:
      paths: [docs/**]
      description: Changes under docs/**.
    enforcement: [history_audit, review]

human_roles: []  # not checked
release_route: needs-human
exclusions: []  # not checked
